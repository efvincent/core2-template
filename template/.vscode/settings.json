{
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/cmake/debug",
    "--header-insertion=never",
    "--background-index",
    "--completion-style=detailed",
    "--clang-tidy"
  ],
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.options.statusBarVisibility": "visible",
  "cmake.debugConfig": {
    "type": "lldb",
    "cwd": "${workspaceFolder}"
  },
  "files.associations": {
    "*.cppm": "cpp"
  },
  "files.exclude": {
    "docs/html": true,
    "docs/core2": true
  }
}
