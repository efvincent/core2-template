{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build-release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
