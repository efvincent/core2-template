{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "debug: -O0 -g",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release: -O3 -march=native, NDEBUG",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -march=native -DNDEBUG -g"
      }
    },
    {
      "name": "lto",
      "inherits": "base",
      "displayName": "lto: release with full LTO",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Lto",
        "CMAKE_CXX_FLAGS_LTO": "-O3 -march=native -DNDEBUG -g -flto=full",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib"
      }
    },
    {
      "name": "instrument",
      "inherits": "base",
      "displayName": "instrument: ASan + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Instrument",
        "CMAKE_CXX_FLAGS_INSTRUMENT": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all -fno-sanitize-link-c++-runtime"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",      "configurePreset": "debug" },
    { "name": "release",    "configurePreset": "release" },
    { "name": "lto",        "configurePreset": "lto" },
    { "name": "instrument", "configurePreset": "instrument" }
  ]
}
