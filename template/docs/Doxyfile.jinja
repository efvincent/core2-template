# Doxygen configuration for {{ project_name }}: the reference built from the
# Doxygen comments in src/, with README.md as the main page and docs/*.md as
# pages. Only settings that differ from Doxygen's defaults are listed
# (`doxygen -g` writes a file with every setting and its default).
#
#   cmake --build --preset debug --target docs    (or, from the root: doxygen docs/Doxyfile)
#
# Output: docs/html/index.html (git-ignored). Any warning fails the build,
# undocumented exported names included, as in core2.

PROJECT_NAME           = "{{ project_name }}"
OUTPUT_DIRECTORY       = docs
STRIP_FROM_PATH        = src .
TAB_SIZE               = 2
MARKDOWN_ID_STYLE      = GITHUB

# The sources and pages. Names in a `detail` namespace are private helpers.
INPUT                  = README.md docs src
FILE_PATTERNS          = *.cppm *.cpp *.h *.md
EXTENSION_MAPPING      = cppm=C++
RECURSIVE              = YES
# The generated references, not sources.
EXCLUDE                = docs/html docs/latex docs/core2
EXCLUDE_SYMBOLS        = *::detail *::detail::*
USE_MDFILE_AS_MAINPAGE = README.md

# Warnings: all on, and fatal.
QUIET                  = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

# HTML only.
SOURCE_BROWSER         = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
# Links to core2's names go to core2's reference (the core2_docs target),
# relative to docs/html/.
TAGFILES               = docs/core2/core2.tag=../core2/html
